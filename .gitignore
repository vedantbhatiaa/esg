# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets — NEVER commit real credentials ───────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml


# ── Advisory lock files (transient — created by filelock during CSV writes) ───
*.lock

# ── Mock storage (local dev artefact, not real data) ─────────────────────────
mock_storage/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log