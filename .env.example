# TIP ESG Platform — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# The .env file is git-ignored and must NEVER be committed.
#
# For the ESG firm integration: supply these values via your secrets manager
# (Azure Key Vault, HashiCorp Vault, or Streamlit Cloud secrets).

# ── Microsoft Azure AD App registration ───────────────────────────────────────
# Register an App in portal.azure.com → App registrations
# Grant application permissions: Files.ReadWrite.All + Sites.ReadWrite.All
AZURE_CLIENT_ID=your-azure-app-client-id-here
AZURE_CLIENT_SECRET=your-azure-app-client-secret-here
AZURE_TENANT_ID=your-azure-tenant-id-here

# ── SharePoint document library ───────────────────────────────────────────────
# Format: {hostname}:/{relative-path-to-site}
SHAREPOINT_SITE=consultdss.sharepoint.com:/sites/TIP-ESG
SHAREPOINT_DRIVE=TIP-ESG-Data

# ── Azure OpenAI (for AI insights page) ──────────────────────────────────────
# Create a resource in portal.azure.com → Azure OpenAI
# Deploy a model (e.g. gpt-4o) and copy the endpoint + key here
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o